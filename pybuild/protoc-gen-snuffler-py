#!/usr/bin/env bash
set -euo pipefail

# buf local plugin: generates the typed Python BridgeServicer + dispatch from the
# BridgeService rpc set (no grpc runtime, so it imports in Pyodide).
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_dir="$(dirname "$script_dir")"

exec uv run --project "$repo_dir" --only-group codegen python3 "$script_dir/snuffler_py_plugin.py"
