.DS_Store

# Trunk web build output
/dist

# Rust + JS build artifacts
/target
/node_modules
# bun-bundled TS bridge glue (web/*.ts -> web/gen/*.js), produced at build time
/web/gen
*.rlib

# pyrocko is NOT vendored — fetched on demand (pinned) into sources/ by
# `mise run fetch-pyrocko`. Keep it out of git.
/sources

# pyodide wheel build: keep the scripts (build-wheel.sh, setup.py, bootstrap),
# drop the cross-compiled wheel + all generated toolchain caches.
/dist-py
/web/proto
/pybuild/build
/pybuild/*.log
/pybuild/.emscripten-version
/.venv-pyodide
/.pyodide-xbuildenv-*
/.mypy_cache
/.ruff_cache

# Playwright/debug screenshots
/snuffler-*.png

# https://github.com/lycheeverse/lychee
.lycheecache

# Python bytecode cache
__pycache__/

# experimental pthread Pyodide build (see docker/pyodide-pthread/)
docker/pyodide-pthread/out/
docker/pyodide-pthread/.work/

docker/pyodide-mt/.work/
docker/pyodide-mt/out/
docker/pyodide-mt/served/

# agent scratch + local uv lock (test artifacts)
scratchpad/
uv.lock

# parity harness: generated corpus (manifest.json IS checked in) and run artifacts
/tests/parity/corpus/data
/tests/parity/.artifacts
