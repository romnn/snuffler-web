.DS_Store

# Task and cooldown local state
/.task/
.cooldown.lock

# Trunk web build output
/dist

# Rust + JS build artifacts
/target
/node_modules
# bun-bundled TS bridge glue (web/*.ts -> web/gen/*.js), produced at build time
/web/gen
*.rlib

# pyrocko is NOT vendored — fetched on demand (pinned) into sources/ by
# `task fetch:pyrocko`. Keep it out of git.
/sources

# Generated protobuf modules, and output of the retired host wheel build.
/web/proto
/pybuild/build
/.venv-pyodide
/.pyodide-xbuildenv-*
/dist-py
/.mypy_cache
/.ruff_cache
**/.venv

# Playwright/debug screenshots
/snuffler-*.png

# https://github.com/lycheeverse/lychee
.lycheecache

# Python bytecode cache
__pycache__/

docker/pyodide-mt/.work/
docker/pyodide-mt/out/
docker/pyodide-mt/served/

# Agent scratch.
scratchpad/

# parity harness: generated corpus (manifest.json IS checked in) and run artifacts
/tests/parity/corpus/data
/tests/parity/.artifacts
