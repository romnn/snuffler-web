# Copy to .env to configure snuffler-web-proxy: more hosts to allow, on top of the FDSN endpoints
# and SeedLink servers it always allows (crates/snuffler-web-proxy/src/defaults.rs), and where to
# export telemetry.
# The proxy reads .env from its working directory; variables already set in the environment win.
# Both lists are comma-separated.

# Exact URLs `/cors` may forward to, matched by scheme, host, port and path.
SNUFFLER_PROXY_ALLOW_HTTP_TARGETS=https://example.org/fdsnws/dataselect/1/query

# `host:port` pairs `/tcp` may connect to, such as another SeedLink server.
SNUFFLER_PROXY_ALLOW_TCP_TARGETS=seedlink.example.org:18000

# Which events to log and export, such as `debug` or `info,cors_proxy=trace`.
# Unset, the proxy logs its own crates at `info`.
# RUST_LOG=info

# `pretty` (the default) or `json`, one object per line for a log shipper.
SNUFFLER_PROXY_LOG_FORMAT=pretty

# An OpenTelemetry collector to export the proxy's traces, metrics and logs to over OTLP gRPC.
# Unset, the proxy only logs to stderr.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
